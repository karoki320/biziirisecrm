# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://biziirise.com

# ---------- Supabase ----------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. NEVER expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Resend (transactional + sequence email) ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Biziirise <hello@biziirise.com>"
RESEND_REPLY_TO=karokieugene000@gmail.com
# Set in Resend dashboard -> Webhooks, used to verify delivery callbacks
RESEND_WEBHOOK_SECRET=

# ---------- WhatsApp Cloud API (notifications only) ----------
# The wa.me CTA link needs none of this. These are for outbound notifications.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Any random string you also paste into the Meta webhook config
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---------- M-Pesa Daraja ----------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://biziirise.com/api/webhooks/mpesa

# ---------- Claude API (lead-reply drafting, blog outlining) ----------
ANTHROPIC_API_KEY=

# ---------- Automation ----------
# Shared secret Supabase edge functions / pg_net use to call Next.js server routes
AUTOMATION_WEBHOOK_SECRET=
